{
  "name": "managed-oss-cloud",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "bin": {
    "supersuite": "dist-server/cli/index.js",
    "supersuite-mcp": "dist-server/mcp/index.js"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch src/server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "worker": "node dist-server/server/provisioning-worker.js",
    "gateway": "node dist-server/server/gateway-reconciler.js",
    "ai-worker": "node dist-server/server/ai-worker.js",
    "test": "vitest run",
    "test:postgres-acceptance": "vitest run tests/postgres-shared-clients.acceptance.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "cli": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "verify:live-products": "node scripts/verify-live-product-clients.mjs",
    "generate:products": "node --import tsx scripts/generate-product-repositories.mjs",
    "audit:licenses": "node scripts/license-audit.mjs",
    "migrate": "node dist-server/server/migrate-command.js",
    "attest:external-evidence": "node dist-server/server/external-evidence-attestation-command.js",
    "reconcile:subscriptions": "node dist-server/server/reconcile-subscriptions-command.js",
    "reconcile:subscriptions:worker": "node dist-server/server/subscription-reconciliation-worker.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@phosphor-icons/react": "^2.1.10",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
