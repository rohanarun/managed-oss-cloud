PRODUCT_NAME=Managed OSS Cloud
PORT=8787
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_HOST_TARGET=apps.getsupers.com
PLATFORM_IPV4=34.44.230.152
PROVISIONING_MODE=dry-run
PROVISIONING_WORKER=disabled
DATABASE_MIGRATION_MODE=auto
# Phase-A PostgreSQL role separation. Empty values retain DATABASE_URL compatibility during staged rollout.
# DATABASE_RUNTIME_URL=postgresql://managed_runtime_login:secret@database:5432/opendock
# DATABASE_AI_URL=postgresql://managed_ai_login:secret@database:5432/opendock
# DATABASE_MIGRATOR_URL=postgresql://managed_migrator_login:secret@database:5432/opendock
HOST_APPS_ROOT=/opt/managed-oss/apps/workspaces
HOST_CADDY_CONFIG=/opt/managed-oss/config/apps.caddy
PLATFORM_DOCKER_NETWORK=config_default
PLATFORM_CADDY_CONTAINER=config_caddy_1
# The control gateway reconciler shares Caddy's network namespace; the admin API must remain loopback-only.
CADDY_ADMIN_URL=http://127.0.0.1:2019/load
BACKUP_BUCKET=
BACKUP_KEY_HEX=
# Hosted Google Cloud workers enroll with a fresh full-format instance identity document.
# Configure all four only on the control plane; put only the audience on each worker.
# GCP_WORKER_IDENTITY_AUDIENCE=https://cloud.getsupers.com/api/agent/register
# GCP_WORKER_IDENTITY_PROJECT_ID=local-passage-501917-g0
# GCP_WORKER_IDENTITY_INSTANCE_NAMES=managed-oss-host-worker-0
# GCP_WORKER_IDENTITY_ZONES=us-central1-a
# WORKER_BOOTSTRAP_TOKEN is an operator-only drain/status credential on hosted control planes.
# It remains a self-hosted enrollment fallback when no GCP identity policy is configured.
# WORKER_BOOTSTRAP_TOKEN=
# Remote workers advertise all three capacity dimensions and retain explicit host reserves.
# WORKER_CAPACITY_MEMORY_MB=7168
# WORKER_CAPACITY_CPU_MILLIS=1800
# WORKER_CAPACITY_STORAGE_GB=180
# WORKER_SYSTEM_RESERVE_MEMORY_MB=768
# WORKER_SYSTEM_RESERVE_CPU_MILLIS=200
# WORKER_SYSTEM_RESERVE_STORAGE_GB=15
# WORKER_LAUNCH_MEMORY_RESERVE_MB=160
# WORKER_STORAGE_SCAN_MILLISECONDS=60000
# Plain ext4 bind mounts support measured stop/quarantine only, not hard byte enforcement.
WORKER_STORAGE_QUOTA_BACKEND=measurement-only
WORKER_STORAGE_QUOTA_PROOF_COMPLETED=false
# Live billing requires operator-project-quota, proof completion, and an operator-installed helper on each worker.
# WORKER_STORAGE_QUOTA_HELPER=/opt/managed-oss/quota/bin/managed-project-quota
# Hosting-layer Google OAuth. The five private settings below belong only on the control plane.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_STATE_SECRET=
# GOOGLE_OAUTH_CALLBACK_URL=https://cloud.getsupers.com/oauth/google/callback
# GOOGLE_OAUTH_ASSERTION_SIGNING_PRIVATE_KEY=
# These two public settings also go to trusted worker agents so manifests can give HeyForm only the broker URL and Ed25519 verification key.
# GOOGLE_OAUTH_BROKER_START_URL=https://cloud.getsupers.com/oauth/google/start
# GOOGLE_OAUTH_ASSERTION_PUBLIC_KEY=
PLAN_CATALOG_JSON={"starter":{"label":"Starter","memoryMb":1536,"cpu":0.5,"storageGb":10,"maxServices":2,"infrastructureMonthlyCents":500,"monthlyCents":700},"scale":{"label":"Scale","memoryMb":6144,"cpu":2,"storageGb":100,"maxServices":12,"infrastructureMonthlyCents":4464,"monthlyCents":5000},"fleet":{"label":"Fleet","memoryMb":24576,"cpu":8,"storageGb":500,"maxServices":50,"infrastructureMonthlyCents":17857,"monthlyCents":20000}}
PLATFORM_FEE_PERCENT=12
PLATFORM_FEE_MIN_CENTS=200
# Logical memory headroom charged once per customer installation for plan-capacity checks and legacy allocation backfills.
APPLICATION_MEMORY_SAFETY_RESERVE_MB=192
CUSTOM_DOMAIN_MONTHLY_CENTS=0
SESSION_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_MODE=disabled
SUBSCRIPTION_RECONCILIATION_MODE=disabled
SUBSCRIPTION_RECONCILIATION_INTERVAL_MILLISECONDS=900000
PAID_CAPACITY_RECOVERY_WINDOW_MILLISECONDS=86400000
AI_MODE=disabled
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen3:4b
AI_API_KEY=
AI_POLL_MILLISECONDS=2000
AI_REQUEST_TIMEOUT_MILLISECONDS=90000
# Optional deploy/google-cloud local-ai profile. The dashboard/API remain usable with AI_MODE=disabled.
# The profile overrides the local worker endpoint to http://ollama:11434/v1 and pulls this model once.
LOCAL_AI_MODEL=qwen3:4b
LOCAL_AI_MODEL_DIGEST=359d7dd4bcdab3d86b87d73ac27966f4dbb9f5efdfcc75d34a8764a09474fae7
LOCAL_AI_CONTEXT_LENGTH=8192
LOCAL_AI_KEEP_ALIVE=5m
LOCAL_AI_MAX_LOADED_MODELS=1
LOCAL_AI_NUM_PARALLEL=1
SUITE_ENTITLEMENT_MODE=hosted
HOSTING_ENTITLEMENT_MODE=hosted
# Required for public consent policy and receipt endpoints. Inject a base64 PKCS#8 Ed25519 private key from the deployment secret store.
# CONSENT_POLICY_SIGNING_PRIVATE_KEY=
CONSENT_POLICY_PREVIOUS_PUBLIC_KEYS_JSON=[]
