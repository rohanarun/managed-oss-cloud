project_id    = "your-google-cloud-project"
region        = "us-west1"
zone          = "us-west1-b"
instance_name = "managed-oss-host"
machine_type  = "e2-micro"
disk_size_gb  = 30
control_plane_image  = "ghcr.io/rohanarun/managed-oss-cloud:latest"
control_plane_domain = "control.example.com"
apps_domain          = "apps.example.com"
provisioning_mode    = "dry-run"
provisioning_worker  = "disabled"
billing_mode         = "disabled"
stripe_publishable_key = "pk_live_or_test_key"
backup_bucket         = "managed-oss-backups-project-number"
